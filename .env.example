# ── Required ──────────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here

# OpenRouter — free, no phone, no credit card, email only
# Sign up: https://openrouter.ai  →  Keys  →  Create Key
# Key starts with: sk-or-
NVIDIA_API_KEY=sk-or-your_openrouter_key_here

# ── Optional ──────────────────────────────────────────────

# SerpAPI for better web search (if empty → free DuckDuckGo is used)
SERPAPI_KEY=

# Pixabay for real photo search (send_image action)
# Free at: https://pixabay.com/api/docs/  (just email, no phone)
PIXABAY_API_KEY=

# GNews for better news results
# Free at: https://gnews.io  (100 req/day free)
GNEWS_API_KEY=
