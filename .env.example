# ── Required ──────────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Get free from: https://build.nvidia.com → Settings → API Keys
# Key starts with: nvapi-
NVIDIA_API_KEY=nvapi-your_key_here

# ── Optional ──────────────────────────────────────────────

# SerpAPI for better web search (if empty, DuckDuckGo is used for free)
SERPAPI_KEY=

# Pixabay for real photo search (send_image action)
# Free at: https://pixabay.com/api/docs/
PIXABAY_API_KEY=
